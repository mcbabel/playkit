{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Playkit",
  "identifier": "io.github.playkit",
  "build": {
    "frontendDist": "../ui",
    "beforeBuildCommand": "cargo build -p playkit-loader --release --target x86_64-pc-windows-gnu",
    "beforeDevCommand": "cargo build -p playkit-loader --release --target x86_64-pc-windows-gnu"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Playkit",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "decorations": false,
        "backgroundColor": "#11151D"
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self'; font-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "appimage", "deb"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Game",
    "shortDescription": "Community mod launcher for Project Playtime",
    "windows": {
      "nsis": { "installMode": "currentUser" }
    }
  }
}
